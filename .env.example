# Copy to .env and fill in:  cp .env.example .env

# Google Gemini API key: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-gemini-api-key-here

# Optional overrides.
# The chat model is an alias so it survives Google retiring specific versions.
# The embedding model is pinned on purpose: changing it changes the vector
# dimension, which invalidates an index you have already built.
GEMINI_MODEL=gemini-flash-latest
EMBEDDING_MODEL=models/gemini-embedding-001
